{
  "name": "badger-flores-chess",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare-engine.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && node scripts/prepare-engine.mjs && vite build && node scripts/prepare-offline.mjs",
    "deploy": "npm run build && gh-pages --dist dist --branch gh-pages --nojekyll",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stockfish": "17.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "gh-pages": "6.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
